DEFVER=1
ARCHS_SUPPORTED="amd64"

get_github_releases "Windscribe/Desktop-App" "latest"

if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 -E 'browser_download_url.*windscribe_[0-9]+(\.[0-9]+)*_amd64\.deb"' "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(sed -E 's|.*/download/v?([^/]+)/.*|\1|' <<< "${URL}")
fi

PRETTY_NAME="Windscribe"
WEBSITE="https://windscribe.com/"
SUMMARY="VPN desktop application"
