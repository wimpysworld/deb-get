DEFVER=1
ARCHS_SUPPORTED="amd64"

PRETTY_NAME="PrivacyNotes"
WEBSITE="https://privacynotes.app/"
SUMMARY="End-to-end encrypted notes, tasks, files, passwords and journal"

get_github_releases "LifetimeLabsHQ/PrivacyNotes.app" "latest"

if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 -E 'browser_download_url.*PrivacyNotes_[0-9]+(\.[0-9]+)*_amd64\.deb"' "${CACHE_FILE}" | cut -d '"' -f 4)

    VERSION_PUBLISHED=$(echo "${URL}" | grep -oE 'PrivacyNotes_[0-9]+(\.[0-9]+)*_amd64\.deb' | sed -E 's/^PrivacyNotes_//; s/_amd64\.deb$//')
fi
