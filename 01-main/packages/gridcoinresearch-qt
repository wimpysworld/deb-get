DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
CODENAMES_SUPPORTED="bookworm trixie"
get_github_releases "gridcoin-community/Gridcoin-Research" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*gridcoinresearch-qt_.*\.${UPSTREAM_CODENAME}-[0-9]*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(sed -E 's/.*_([0-9.]+)\.[a-z]+-([0-9]+)_.*/\1-\2/' <<< "${URL}")
fi
PRETTY_NAME="Gridcoin"
WEBSITE="https://gridcoin.us/"
SUMMARY="An open source cryptocurrency that rewards volunteer computing through BOINC."
