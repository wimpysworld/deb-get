DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "UniClipboard/UniClipboard" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="UniClipboard"
WEBSITE="https://www.uniclipboard.app/"
SUMMARY="Privacy-first, end-to-end encrypted clipboard sync across your devices"
