DEFVER=1
ARCHS_SUPPORTED="amd64"

get_github_releases "SimoHypers/limusic" "latest"

if [ "${ACTION}" != prettylist ]; then
    URL=$(grep -m 1 "browser_download_url.*_amd64\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi

PRETTY_NAME="Limusic"
WEBSITE="https://simohypers.github.io/limusic/"
SUMMARY="A lightweight desktop player for YouTube Music"
