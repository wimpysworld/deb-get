DEFVER=1
ARCHS_SUPPORTED="amd64"
get_github_releases "mongodb-js/compass" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*/mongodb-compass_[^\"/]*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '_' -f 2 <<< "${URL##*/}")
fi
PRETTY_NAME="MongoDB Compass"
WEBSITE="https://www.mongodb.com/products/tools/compass"
SUMMARY="Interactive graphical user interface for querying, aggregating, and analysing MongoDB data."
