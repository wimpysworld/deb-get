DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "anuzdhk/linux-taskmanager" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed 's/^v//')
fi
PRETTY_NAME="TaskMonitor"
WEBSITE="https://anuzsystems.vercel.app/apps/linux-taskmanager/"
SUMMARY="Task manager for Linux with processes, performance graphs, services, startup apps and users."
