DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "matthart1983/netwatch" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="netwatch"
WEBSITE="https://www.netwatchlabs.com/"
SUMMARY="Real-time network diagnostics in your terminal: every connection with the process behind it, per-hop latency, and decoded packets, plus a Diagnose tab that learns what normal looks like on your network"
