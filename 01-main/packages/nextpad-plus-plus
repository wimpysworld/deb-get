DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "nextpad-plus-plus/nextpad-plus-plus-linux" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="Nextpad++"
WEBSITE="https://github.com/nextpad-plus-plus/nextpad-plus-plus-linux"
SUMMARY="A native GTK4 port of Notepad++ for Linux."
