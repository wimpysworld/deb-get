DEFVER=2
ARCHS_SUPPORTED="amd64 arm64 i386"
case ${HOST_ARCH} in
    amd64) CODENAMES_SUPPORTED="bookworm trixie jammy noble resolute stonking" ;;
    arm64) CODENAMES_SUPPORTED="trixie noble resolute" ;;
    i386) CODENAMES_SUPPORTED="bookworm" ;;
esac
get_github_releases "veracrypt/VeraCrypt" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 -E "browser_download_url.*veracrypt-[0-9\.]+-${UPSTREAM_ID^}-${UPSTREAM_RELEASE}-${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//VeraCrypt_/}")
fi
PRETTY_NAME="Veracrypt"
WEBSITE="https://veracrypt.jp/"
SUMMARY="VeraCrypt is a free and open-source utility for on-the-fly encryption (OTFE)."