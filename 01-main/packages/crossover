DEFVER=1

get_website "https://www.codeweavers.com/crossover/changelog"

# pkgrel=1
_pkgdebrel=1

if [ "${ACTION}" != "prettylist" ]; then
    # shellcheck disable=SC2168,SC2155
    VERSION_PUBLISHED=$(grep -m 1 -E '<a name=\"([[:digit:]])+' "${CACHE_FILE}" | cut -d \" -f 2)
    URL="https://media.codeweavers.com/pub/${APP}/cxlinux/demo/${APP}_${VERSION_PUBLISHED}-${_pkgdebrel}.deb"
fi
PRETTY_NAME="CrossOver"
WEBSITE="https://www.codeweavers.com/crossover"
SUMMARY="Run your Windows apps on Linux! CrossOver is a Microsoft Windows compatibility layer based on Wine."
