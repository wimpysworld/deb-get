DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
CODENAMES_SUPPORTED="bookworm trixie forky sid jammy noble plucky questing resolute"
ARCH=${HOST_ARCH}
case "${ARCH}" in
    amd64) ARCH=-linux-x86_64 ;;
    arm64) ARCH=-linux-aarch64 ;;
    *) ;;
esac
get_github_releases "storytold/pdfcraft" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*pdfcraft-.*${ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed 's/^v//')
fi
PRETTY_NAME="PdfCraft"
WEBSITE="https://getartcraft.com/apps/pdfcraft"
SUMMARY="Read, comment, fill and sign, organize, combine, split, redact and protect PDFs in a fast native app."
