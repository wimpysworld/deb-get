DEFVER=1
ARCHS_SUPPORTED="amd64"

PRETTY_NAME="Xtreme Download Manager"
WEBSITE="https://xtremedownloadmanager.com/"
SUMMARY="Powerful download accelerator and video downloader"

get_github_releases "subhra74/xdm" "latest"

if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 -E 'browser_download_url.*xdm-app_[0-9]+(\.[0-9]+)*_amd64\.deb"' "${CACHE_FILE}" | cut -d '"' -f 4)

    VERSION_PUBLISHED=$(echo "${URL}" | grep -oE 'xdm-app_[0-9]+(\.[0-9]+)*_amd64\.deb' | sed -E 's/^xdm-app_//; s/_amd64\.deb$//')
fi
