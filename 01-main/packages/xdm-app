DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "subhra74/xdm" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*xdm-app_.*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="Xtreme Download Manager"
WEBSITE="https://xtremedownloadmanager.com/"
SUMMARY="A download accelerator and video downloader with browser integration and resumable transfers."
