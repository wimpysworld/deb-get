DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_github_releases "pingdotgg/t3code" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*T3-Code-.*-${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="T3 Code"
WEBSITE="https://t3.codes/"
SUMMARY="Open-source desktop GUI for coding agents."
