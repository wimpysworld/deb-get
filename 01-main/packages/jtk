DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
# The repo also publishes cfl, and "latest" may point at either app
get_github_releases "open-cli-collective/atlassian-cli"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*/jtk_.*_linux_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '_' -f 2 <<< "${URL##*/}")
fi
PRETTY_NAME="jtk"
WEBSITE="https://github.com/open-cli-collective/atlassian-cli"
SUMMARY="Jira Cloud CLI for issues, sprints, boards, dashboards, and automation."
