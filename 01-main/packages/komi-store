DEFVER=1
ARCHS_SUPPORTED="amd64"
get_github_releases "komi-store/komi-store" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*komi-store_.*_${HOST_ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="Komi Store"
WEBSITE="https://www.komistore.app/"
SUMMARY="A cross-platform app store for discovering and installing open-source software from GitHub releases."
