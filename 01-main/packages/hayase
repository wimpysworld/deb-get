
DEFVER=1
ARCHS_SUPPORTED="amd64"

PRETTY_NAME="Hayase"
WEBSITE="https://hayase.watch/"
SUMMARY="Anime streaming application"

get_github_releases "hayase-app/ui" "latest"

if [ "${ACTION}" != prettylist ]; then
    URL=$(grep -oE 'https://api\.hayase\.watch/files/linux-hayase-[0-9]+(\.[0-9]+)*-linux\.deb' "${CACHE_FILE}" | head -n 1)

    VERSION_PUBLISHED=$(sed -E 's|.*/linux-hayase-([0-9]+(\.[0-9]+)*)-linux\.deb|\1|' <<< "${URL}")
fi
