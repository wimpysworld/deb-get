DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
get_website "https://linux.weixin.qq.com/"
if [ "${ACTION}" != prettylist ]; then
    case "${HOST_ARCH}" in
        amd64) WECHAT_ARCH="x86_64" ;;
        arm64) WECHAT_ARCH="arm64" ;;
    esac
    URL="https://dldir1v6.qq.com/weixin/Universal/Linux/WeChatLinux_${WECHAT_ARCH}.deb"
    VERSION_PUBLISHED=$(grep -oP 'main-section__bd-version[^>]*>\K[0-9]+\.[0-9]+\.[0-9]+' "${CACHE_FILE}" | head -n 1)
fi
PRETTY_NAME="WeChat"
WEBSITE="https://linux.weixin.qq.com/"
SUMMARY="Official WeChat desktop client for Linux."
