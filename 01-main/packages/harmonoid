DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
ARCH=${HOST_ARCH}
case "${ARCH}" in
    amd64) ARCH=x86_64 ;;
    arm64) ARCH=aarch64 ;;
    *) ;;
esac
get_github_releases "alexmercerind2/harmonoid-releases" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*harmonoid-linux-${ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL}" | sed -E 's/^v//; s/-.*//')
fi
PRETTY_NAME="Harmonoid"
WEBSITE="https://harmonoid.com/"
SUMMARY="Plays and manages your music library."
