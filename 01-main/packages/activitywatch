DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
ARCH=${HOST_ARCH}
case "${ARCH}" in
    amd64) ARCH=-linux-x86_64 ;;
    arm64) ARCH=-linux-aarch64 ;;
    *) ;;
esac
get_github_releases "ActivityWatch/activitywatch" "latest"
if [ "${ACTION}" != "prettylist" ]; then
    URL=$(grep -m 1 "browser_download_url.*-tauri.*${ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '/' -f 8 <<< "${URL//v/}")
fi
PRETTY_NAME="ActivityWatch"
WEBSITE="https://activitywatch.net/"
SUMMARY="The best free and open-source automated time tracker. Cross-platform, extensible, privacy-focused."
