DEFVER=1
ARCHS_SUPPORTED="amd64 arm64"
case "${HOST_ARCH}" in
    amd64) ARCH="x86_64" ;;
    arm64) ARCH="aarch64" ;;
    *) ARCH="" ;;
esac
get_github_releases "storytold/wordcraft" "latest"
if [ "${ACTION}" != "prettylist" ] && [ -n "${ARCH}" ]; then
    URL=$(grep -m 1 "browser_download_url.*/wordcraft-[^\"/]*-linux-${ARCH}\.deb\"" "${CACHE_FILE}" | cut -d '"' -f 4)
    VERSION_PUBLISHED=$(cut -d '-' -f 2 <<< "${URL##*/}")
fi
PRETTY_NAME="WordCraft"
WEBSITE="https://getartcraft.com/apps/wordcraft"
SUMMARY="Open-source native word processor with DOCX, ODT, RTF, Markdown, and PDF export support."
